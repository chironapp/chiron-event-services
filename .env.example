# Supabase Configuration
# Get these values from your Supabase project dashboard
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Development settings
# EXPO_PUBLIC_DEBUG=true

# Cloudflare Turnstile site key for the public registration form (events/[id]/register).
# This is the PUBLIC site key; the matching secret lives in Supabase (TURNSTILE_SECRET_KEY).
# For local development use Cloudflare's always-passing test key:
EXPO_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
